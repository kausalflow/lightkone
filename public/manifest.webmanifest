{
  "name": "Lightkone",
  "short_name": "Lightkone",
  "description": "Your research papers: read, highlight, cite and ask Claude.",
  "id": "./",
  "start_url": "./app/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1d2433",
  "theme_color": "#1d2433",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./app/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "pdf", "accept": ["application/pdf", ".pdf", "text/html", ".html", ".htm", "multipart/related", "message/rfc822", ".mhtml", ".mht"] }]
    }
  }
}
